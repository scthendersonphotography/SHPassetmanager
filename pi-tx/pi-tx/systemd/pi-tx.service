[Unit]
Description=Pi TX — Laser Eye camera trigger daemon
After=network.target
Wants=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-/etc/pi-tx.conf
ExecStart=/usr/bin/python3 __INSTALL_DIR__/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-tx

# Allow binding to port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# GPIO access
SupplementaryGroups=gpio i2c

[Install]
WantedBy=multi-user.target
